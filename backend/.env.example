# ============================================================
# KimiFiction 环境变量配置示例
# 复制此文件为 .env.local 并填入实际值
# ============================================================

# ── 数据库 ─────────────────────────────────────────
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=novel_user
MYSQL_PASSWORD=novel_password
MYSQL_DATABASE=novel_system

# ── Redis ──────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Qdrant 向量数据库 ──────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=novel_memories

# ── LLM 配置 ───────────────────────────────────────
# 可选值: openai, deepseek, kimi, yuanbao, local_llama
LLM_PROVIDER=deepseek

# DeepSeek（推荐，高性价比）
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# OpenAI（可选）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4-turbo-preview

# chat2api 本地服务（用于 Kimi/元宝等需本地代理）
CHAT2API_BASE_URL=http://localhost:8000

# ── 本地 Ollama 模型 ───────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
LOCAL_LLAMA_MODEL_PATH=
LOCAL_LLAMA_MAX_TOKENS=2048
LOCAL_LLAMA_CONTEXT_WINDOW=4096

# ── 应用配置 ──────────────────────────────────────
APP_NAME=KimiFiction
APP_VERSION=1.0.0
DEBUG=true
SECRET_KEY=change-this-in-production

PORT=8000

# ── CORS 配置（重要！部署时必须修改）──────────────
# 格式: JSON 数组字符串 或 逗号分隔的 URL 列表
#
# 开发环境（本地）:
#   CORS_ORIGINS=["http://localhost:5173","http://localhost:5174"]
#
# 生产部署（服务器）:
#   CORS_ORIGINS=http://你的服务器IP:80
#
# Docker 生产部署（通过 Nginx）:
#   CORS_ORIGINS=["http://frontend:80","http://你的服务器IP:80","https://你的域名.com"]
#
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174","http://127.0.0.1:5173","http://127.0.0.1:5174"]

# ── 生成配置 ──────────────────────────────────────
MAX_CHAPTERS=1000
DEFAULT_CHAPTER_WORDS=3000
SUMMARY_INTERVAL=10

# ── 向量模型 ──────────────────────────────────────
EMBEDDING_MODEL=bge-large-zh